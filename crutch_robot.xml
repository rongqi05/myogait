<?xml version="1.0"?>
<!--
  crutch_robot.xml -- 等效全向底盘轮式拐杖机器人（首版）

  几何/质量缺省值（均为可修改的仿真初值）：
    chassis box 全尺寸 0.39 x 0.29 x 0.25 m   -> size 为半尺寸 0.195 0.145 0.125
    chassis 质量 15.5 kg；杆件、把手质量单独设置
    chassis 名义离地间隙 0.05 m（box 底面高度），底盘中心 z = 0.175
    支撑杆 1.00 m 圆柱，从底盘上表面 (z=0.30) 起算
    把手 水平圆柱，位于 z = 1.30
    slide_x / slide_y 为世界平移轴，yaw 为 Z hinge，仅靠阻尼抑制摆动
    X/Y 速度伺服，输出力限幅 ±400 N
    所有拐杖 geom 不参与接触（contype=conaffinity=0），底盘由关节约束支撑
    轮子仅显示，各 1 g，避免改变底盘 15.5 kg 的标定质量

  演示占位 site：hand_stub_l / hand_stub_r（自由刚体）上的 hand_site_l / hand_site_r。
  集成到 MyoFullBody 时把两条 connect 的 body2 改为 radius_l / radius_r，
  并把 anchor2 交给 env_step_snippet.align_grip() 重算，见该文件说明。
-->
<mujoco model="crutch_robot">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast" cone="elliptic" impratio="10.0"/>

  <default>
    <geom contype="0" conaffinity="0"/>
    <default class="chassis"><geom rgba="0.30 0.32 0.36 1"/></default>
    <default class="shaft"><geom rgba="0.72 0.74 0.78 1"/></default>
    <default class="grip"><geom rgba="0.16 0.34 0.52 1"/></default>
    <default class="deco"><geom rgba="0.14 0.14 0.16 1"/></default>
    <default class="stub"><geom rgba="0.85 0.55 0.35 0.35"/></default>
  </default>

  <worldbody>
    <geom name="ground" type="plane" size="6 6 0.1" rgba="0.34 0.35 0.37 1" contype="0" conaffinity="0"/>

    <body name="chassis" pos="0 0 0.175">
      <joint name="slide_x" type="slide" axis="1 0 0" damping="1.0"/>
      <joint name="slide_y" type="slide" axis="0 1 0" damping="1.0"/>
      <joint name="yaw" type="hinge" axis="0 0 1" damping="20.0"/>

      <geom name="chassis_box" class="chassis" type="box" size="0.195 0.145 0.125" mass="15.5"/>
      <site name="chassis_center" size="0.012" rgba="0.95 0.75 0.2 0.7"/>

      <geom name="wheel_fl" class="deco" type="cylinder" size="0.05 0.018" pos="0.115 0.095 -0.125" mass="0.001" euler="1.5707963 0 0"/>
      <geom name="wheel_fr" class="deco" type="cylinder" size="0.05 0.018" pos="0.115 -0.095 -0.125" mass="0.001" euler="1.5707963 0 0"/>
      <geom name="wheel_rl" class="deco" type="cylinder" size="0.05 0.018" pos="-0.115 0.095 -0.125" mass="0.001" euler="1.5707963 0 0"/>
      <geom name="wheel_rr" class="deco" type="cylinder" size="0.05 0.018" pos="-0.115 -0.095 -0.125" mass="0.001" euler="1.5707963 0 0"/>

      <body name="rod" pos="0 0 0.125">
        <geom name="rod_shaft" class="shaft" type="cylinder" size="0.016 0.5" pos="0 0 0.5" mass="2.0"/>

        <body name="handle" pos="0 0 1.0">
          <geom name="handle_bar" class="grip" type="cylinder" size="0.015 0.12" euler="1.5707963 0 0" mass="0.6"/>
          <site name="grip_point" size="0.01" rgba="1.0 0.35 0.35 0.8"/>
          <site name="grip_sensor" size="0.008" rgba="0.2 0.9 0.9 0.6"/>
        </body>
      </body>
    </body>

    <body name="hand_stub_l" pos="0 0.09 1.30">
      <freejoint name="hand_stub_l_free"/>
      <geom name="hand_stub_l_geom" class="stub" type="sphere" size="0.045" mass="6.0"/>
      <site name="hand_site_l" size="0.01" rgba="0.9 0.5 0.3 0.8"/>
    </body>

    <body name="hand_stub_r" pos="0 -0.09 1.30">
      <freejoint name="hand_stub_r_free"/>
      <geom name="hand_stub_r_geom" class="stub" type="sphere" size="0.045" mass="6.0"/>
      <site name="hand_site_r" size="0.01" rgba="0.9 0.5 0.3 0.8"/>
    </body>
  </worldbody>

  <equality>
    <connect name="grip_l" body1="handle" body2="hand_stub_l" anchor="0 0 0"
             active="false" solref="0.02 1" solimp="0.9 0.95 0.001"/>
    <connect name="grip_r" body1="handle" body2="hand_stub_r" anchor="0 0 0"
             active="false" solref="0.02 1" solimp="0.9 0.95 0.001"/>
  </equality>

  <actuator>
    <velocity name="crutch_x" joint="slide_x" kv="1500" ctrlrange="-2 2" forcerange="-400 400"/>
    <velocity name="crutch_y" joint="slide_y" kv="1500" ctrlrange="-2 2" forcerange="-400 400"/>
  </actuator>

  <sensor>
    <force name="grip_force" site="grip_sensor"/>
    <torque name="grip_torque" site="grip_sensor"/>
    <framepos name="chassis_pos" objtype="site" objname="chassis_center"/>
    <framelinvel name="chassis_vel" objtype="site" objname="chassis_center"/>
  </sensor>
</mujoco>
